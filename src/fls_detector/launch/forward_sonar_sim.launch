<?xml version="1.0"?>
<launch>
  <arg name="backend" default="raytrace"/>
  <arg name="_checked_backend" value="$(eval {'raytrace': True, 'legacy': True}[arg('backend')])"/>
  <arg name="config_file" default="$(find fls_detector)/config/bhq750d_hf.yaml"/>
  <arg name="max_range" default="15.0"/>
  <!-- Fixed historical geometry is only for 10 m; noise uses its own metre axis. -->
  <arg name="config_overlay" default="$(eval find('fls_detector') + '/config/bhq750d_historical_256.yaml' if float(arg('max_range')) == 10.0 else '')"/>
  <arg name="noise_profile" default="$(find fls_detector)/config/bhq750d_noise_experiment_10m.yaml"/>
  <arg name="random_seed" default="-1"/>
  <arg name="robot_odom_topic" default="/mavros/local_position/odom"/>
  <arg name="target_pose_topic" default="/dynamic_target/pose"/>
  <arg name="image_topic" default="/forward_sonar/image"/>
  <arg name="raw_image_topic" default="/forward_sonar/image_raw"/>
  <arg name="marker_topic" default="/forward_sonar/markers"/>
  <arg name="obstacle_marker_topic" default="/dynamic_obstacles/markers"/>
  <arg name="enable_obstacle_echoes" default="true"/>
  <arg name="show_range" default="true"/>
  <arg name="show_window" default="true"/>
  <arg name="target_mesh_resource" default="package://vuram_description/meshes/AUV.STL"/>
  <arg name="target_mesh_scale" default="1.0"/>
  <arg name="min_range" default="0.2"/>
  <arg name="fov_deg" default="130.0"/>
  <arg name="publish_rate" default="10.0"/>
  <arg name="multipath" default="false"/>
  <rosparam command="load" file="$(arg config_file)" ns="forward_sonar_sim"/>
  <rosparam if="$(eval arg('config_overlay') != '')" command="load" file="$(arg config_overlay)" ns="forward_sonar_sim"/>
  <rosparam if="$(eval arg('noise_profile') != '')" command="load" file="$(arg noise_profile)" ns="forward_sonar_sim"/>
  <param name="forward_sonar_sim/random_seed" value="$(arg random_seed)"/>
  <param name="forward_sonar_sim/robot_odom_topic" value="$(arg robot_odom_topic)"/>
  <param name="forward_sonar_sim/target_pose_topic" value="$(arg target_pose_topic)"/>
  <param name="forward_sonar_sim/obstacle_marker_topic" value="$(arg obstacle_marker_topic)"/>
  <param name="forward_sonar_sim/enable_obstacle_echoes" value="$(arg enable_obstacle_echoes)"/>
  <param name="forward_sonar_sim/image_topic" value="$(arg image_topic)"/>
  <param name="forward_sonar_sim/target_mesh_resource" value="$(arg target_mesh_resource)"/>
  <param name="forward_sonar_sim/target_mesh_scale" value="$(arg target_mesh_scale)"/>
  <param name="forward_sonar_sim/publish_rate" value="$(arg publish_rate)"/>
  <param name="forward_sonar_sim/fov_deg" value="$(arg fov_deg)"/>
  <param name="forward_sonar_sim/max_range" value="$(arg max_range)"/>
  <param name="forward_sonar_sim/min_range" value="$(arg min_range)"/>
  <param name="forward_sonar_sim/raw_image_topic" value="$(arg raw_image_topic)"/>
  <param name="forward_sonar_sim/multipath" value="$(arg multipath)"/>
  <param name="/forward_sonar/geometry/fov_deg" value="$(arg fov_deg)"/>
  <param name="/forward_sonar/geometry/max_range" value="$(arg max_range)"/>
  <param name="/forward_sonar/geometry/min_range" value="$(arg min_range)"/>
  <node if="$(eval arg('backend') == 'raytrace')" name="forward_sonar_sim" pkg="fls_detector" type="forward_sonar_raytrace_node" output="screen" required="true" clear_params="true"/>
  <node if="$(eval arg('backend') == 'legacy')" name="forward_sonar_sim" pkg="fls_detector" type="forward_sonar_sim.py" output="screen" clear_params="true">
    <!-- 随机种子参数：控制声呐图像噪声与回波采样的随机性。 -->

    <!-- 话题映射参数：连接机器人、目标、障碍物与图像输出接口。 -->

    <!-- 目标网格回波参数：配置目标模型类型、采样密度与阴影效果。 -->
    <param name="target_model" value="mesh"/>
    <param name="target_mesh_sample_count" value="6000"/>
    <param name="target_mesh_point_radius" value="0.045"/>
    <param name="target_mesh_normal_power" value="1.7"/>
    <param name="target_mesh_occlusion_cell" value="2"/>
    <param name="target_mesh_shadow_start" value="0.45"/>
    <param name="target_mesh_shadow_length" value="2.0"/>

    <!-- 障碍物回波参数：控制障碍物表面采样强度和点扩散范围。 -->
    <param name="obstacle_strength" value="170.0"/>
    <param name="obstacle_sample_count" value="260"/>
    <param name="obstacle_point_radius" value="0.11"/>

    <!-- 图像输出参数：控制自动增益、等待图像和量程环显示策略。 -->
    <param name="output_auto_gain" value="true"/>
    <param name="output_gain_percentile" value="99.4"/>
    <param name="publish_waiting_image" value="true"/>
    <param name="show_range_rings" value="false"/>
    <param name="range_ring_spacing" value="5.0"/>

    <!-- 声呐几何参数：定义发布频率、扇区视场和图像分辨率。 -->

    <!-- 边界回波参数：配置是否使用场地边界以及读取的边界参数路径。 -->
    <param name="use_boundary" value="false"/>
    <param name="boundary_param" value="/boundary_loader/sim_enu_points"/>
  </node>

  <!-- ==================== 量程扇形可视化节点 ==================== -->
  <!-- 这一组参数用于在 RViz 中显示前视声呐的扇形覆盖范围。 -->
  <node if="$(arg show_range)" name="forward_sonar_range_viz" pkg="fls_detector" type="forward_sonar_range_viz.py" output="screen">
    <!-- 话题与显示参数：连接机器人里程计和 Marker 输出接口。 -->
    <param name="robot_odom_topic" value="$(arg robot_odom_topic)"/>
    <param name="marker_topic" value="$(arg marker_topic)"/>

    <!-- 量程可视化参数：控制显示频率、视场角和最远量程。 -->
    <param name="publish_rate" value="$(arg publish_rate)"/>
    <param name="fov_deg" value="$(arg fov_deg)"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="min_range" value="$(arg min_range)"/>
  </node>

  <!-- ==================== 图像显示节点 ==================== -->
  <!-- 这一组参数用于弹窗显示生成好的前视声呐图像。 -->
  <node if="$(arg show_window)" name="forward_sonar_image_viewer" pkg="fls_detector" type="forward_sonar_image_viewer.py" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="window_name" value="Forward Looking Sonar"/>
    <param name="colormap" value="true"/>
    <param name="display_scale" value="1.4"/>
  </node>
</launch>
