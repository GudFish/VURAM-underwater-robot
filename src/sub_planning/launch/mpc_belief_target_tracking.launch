<?xml version="1.0"?>
<launch>
  <!-- ==================== 传感器与显示开关 ==================== -->
  <!-- 这一组参数控制前视声呐仿真和图像窗口是否启用。 -->
  <arg name="forward_sonar" default="true"/>
  <arg name="forward_sonar_window" default="false"/>

  <!-- ==================== 基础控制链路 ==================== -->
  <!-- 启动飞控通信、速度控制与定深复用控制链路。 -->
  <include file="$(find vuram_control)/launch/common_vehicle_control.launch">
    <arg name="pos_ctrl" value="False"/>
    <arg name="vel_ctrl_rate" value="20.0"/>
    <arg name="depth_mux" value="True"/>
    <arg name="input_vel_topic" value="/target_velocity_xy"/>
    <arg name="output_vel_topic" value="/target_velocity"/>
  </include>

  <!-- ==================== 场景与估计链路 ==================== -->
  <!-- 依次启动目标场景、声学方位链路、窗口估计器和 belief 可视化。 -->
  <include file="$(find sub_planning)/launch/dynamic_target.launch"/>
  <include file="$(find sub_planning)/launch/acoustic_tdoa_chain.launch"/>
  <include file="$(find sub_planning)/launch/target_bearing_window_ls.launch"/>
  <include file="$(find sub_planning)/launch/target_belief_viz.launch"/>
  <include if="$(arg forward_sonar)" file="$(find fls_detector)/launch/forward_sonar_sim.launch">
    <arg name="show_window" value="$(arg forward_sonar_window)"/>
  </include>

  <!-- ==================== Belief-aware MPC 节点 ==================== -->
  <!-- 这一组参数用于配置 belief-aware MPC 的输入、时域、约束、信息增益和边界约束。 -->
  <node name="mpc_belief_target_tracker" pkg="sub_planning" type="mpc_belief_target_tracker.py" output="screen">
    <!-- 动力学模型参数：加载共享 Fossen 动力学参数。 -->
    <rosparam command="load" file="$(find sub_planning)/config/fossen3_dynamics.yaml" ns="dynamics"/>

    <!-- 话题接口参数：连接机器人状态、belief 输入和控制输出接口。 -->
    <param name="odom_topic" value="/mavros/local_position/odom"/>
    <param name="belief_topic" value="/target_estimate/belief"/>
    <param name="vel_topic" value="/target_velocity_xy"/>
    <param name="yaw_topic" value="/target_yaw"/>

    <!-- 预测时域参数：设置控制频率、时间步长和预测地平线。 -->
    <param name="control_rate" value="5.0"/>
    <param name="mpc_dt" value="0.2"/>
    <param name="horizon_steps" value="12"/>

    <!-- 跟踪目标参数：定义期望跟随距离、探索距离和到达容差。 -->
    <param name="desired_standoff" value="3.0"/>
    <param name="exploration_standoff" value="4.5"/>
    <param name="goal_tolerance" value="0.8"/>

    <!-- 不确定性调节参数：根据 belief 大小调整跟踪与探索行为。 -->
    <param name="unc_low" value="1.0"/>
    <param name="unc_high" value="8.0"/>
    <param name="unc_pos_gain" value="1.0"/>
    <param name="unc_vel_gain" value="0.4"/>
    <param name="sigma_min" value="0.1"/>

    <!-- 信息增益权重参数：配置方位观测和协方差相关代价项权重。 -->
    <param name="w_sigma" value="1.2"/>
    <param name="w_bearing_trace" value="1.2"/>
    <param name="w_bearing_logdet" value="0.0"/>
    <param name="bearing_noise_std" value="0.08"/>
    <param name="bearing_process_pos" value="0.05"/>
    <param name="bearing_process_vel" value="0.10"/>
    <param name="min_bearing_range" value="0.5"/>

    <!-- 控制约束参数：限制速度、偏航和相邻控制步变化量。 -->
    <param name="u_max" value="0.8"/>
    <param name="v_max" value="0.6"/>
    <param name="r_max" value="0.6"/>
    <param name="du_step_max" value="0.25"/>
    <param name="dv_step_max" value="0.20"/>
    <param name="dyaw_step_max" value="0.30"/>

    <!-- 虚拟控制映射参数：将期望速度映射为动力学控制力矩。 -->
    <param name="psi_kp" value="1.6"/>
    <param name="k_tau_u" value="120.0"/>
    <param name="k_tau_v" value="120.0"/>
    <param name="k_tau_r" value="80.0"/>
    <param name="tau_u_max" value="200.0"/>
    <param name="tau_v_max" value="200.0"/>
    <param name="tau_r_max" value="120.0"/>

    <!-- 代价函数权重参数：平衡跟踪精度、控制平滑性与航向响应。 -->
    <param name="w_track" value="2.0"/>
    <param name="w_terminal_track" value="10.0"/>
    <param name="w_yaw" value="0.8"/>
    <param name="w_ctrl" value="0.2"/>
    <param name="w_sway" value="0.3"/>
    <param name="w_du" value="0.6"/>
    <param name="w_dyaw" value="0.4"/>
    <param name="w_cte" value="2.5"/>

    <!-- 声呐视场约束参数：鼓励控制结果保持目标处于前视声呐有效区域。 -->
    <param name="sonar_fov_deg" value="130.0"/>
    <param name="sonar_min_range" value="0.2"/>
    <param name="sonar_max_range" value="30.0"/>
    <param name="w_sonar_fov" value="8.0"/>
    <param name="w_sonar_range" value="2.0"/>
    <param name="w_sonar_center" value="1.5"/>
    <param name="w_sonar_front" value="4.0"/>

    <!-- 场地边界参数：配置边界约束的参数路径和安全留边。 -->
    <param name="boundary_param" value="/boundary_loader/enu_points"/>
    <param name="boundary_margin" value="1.0"/>
    <param name="boundary_wait_timeout" value="8.0"/>
    <param name="boundary_required" value="true"/>
  </node>
</launch>
