<?xml version="1.0"?>
<launch>
  <arg name="robot_odom_topic" default="/mavros/local_position/odom"/>
  <arg name="state_topic" default="/mavros/state"/>
  <arg name="bearing_topic" default="/target_acoustic_bearing"/>
  <arg name="target_pose_topic" default="/target_estimate/pose"/>
  <arg name="target_twist_topic" default="/target_estimate/twist"/>
  <arg name="belief_topic" default="/target_estimate/belief"/>

  <node name="target_bearing_window_ls" pkg="sub_planning" type="target_bearing_window_ls.py" output="screen">
    <param name="robot_odom_topic" value="$(arg robot_odom_topic)"/>
    <param name="state_topic" value="$(arg state_topic)"/>
    <param name="bearing_topic" value="$(arg bearing_topic)"/>
    <param name="target_pose_topic" value="$(arg target_pose_topic)"/>
    <param name="target_twist_topic" value="$(arg target_twist_topic)"/>
    <param name="belief_topic" value="$(arg belief_topic)"/>
    <param name="filter_rate" value="10.0"/>
    <param name="window_size" value="16"/>
    <param name="min_samples" value="5"/>
    <param name="max_sample_age" value="12.0"/>
    <param name="bearing_noise_std" value="0.10"/>
    <param name="lm_max_iter" value="12"/>
    <param name="lm_tol" value="1e-5"/>
    <param name="lm_lambda" value="1e-3"/>
    <param name="robust_huber_delta" value="0.25"/>
    <param name="reg_position" value="1e-6"/>
    <param name="reg_velocity" value="1e-4"/>
    <param name="max_speed" value="2.0"/>
    <param name="max_distance" value="100.0"/>
    <param name="covariance_cap" value="10000.0"/>
    <param name="reset_on_disarm" value="True"/>
  </node>
</launch>
