<?xml version="1.0"?>
<launch>
    <node name="target_state_estimator_ekf" pkg="sub_planning" type="target_state_estimator_ekf.py" output="screen">
        <param name="robot_odom_topic" value="/mavros/local_position/odom"/>
        <param name="state_topic" value="/mavros/state"/>
        <param name="range_topic" value="/target_acoustic_range"/>
        <param name="target_pose_topic" value="/target_estimate/pose"/>
        <param name="target_twist_topic" value="/target_estimate/twist"/>
        <param name="belief_topic" value="/target_estimate/belief"/>
        <param name="filter_rate" value="10.0"/>
        <param name="range_noise_std" value="0.4"/>
        <param name="use_prior_init" value="False"/>
        <param name="reset_on_disarm" value="True"/>
        <rosparam param="process_noise_diag">[0.5, 0.5, 0.8, 0.8]</rosparam>
        <rosparam param="init_mean">[8.0, 0.0, 0.4, 0.0]</rosparam>
        <rosparam param="init_cov_diag">[9.0, 9.0, 1.0, 1.0]</rosparam>
        <param name="auto_init_range_angle" value="0.35"/>
    </node>

    <node name="target_belief_viz" pkg="sub_planning" type="target_belief_viz.py" output="screen">
        <param name="belief_topic" value="/target_estimate/belief"/>
        <param name="marker_topic" value="/target_estimate/belief_marker"/>
        <param name="ellipse_sigma" value="2.0"/>
        <param name="show_trace" value="True"/>
        <param name="show_pos_std" value="True"/>
    </node>
</launch>
