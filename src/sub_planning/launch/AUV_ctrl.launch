<?xml version="1.0"?>
<launch>
  <!-- ==================== 启动开关参数 ==================== -->
  <!-- 控制控制模式选择与底层速度指令的发布频率。 -->
  <arg name="pos_ctrl" default="False" doc="true for position control, false for velocity control"/>
  <arg name="vel_ctrl_rate" default="20.0" doc="publish rate of body velocity and yaw setpoints"/>
  <!-- show_rviz: 是否启动 RViz 可视化（批量实验设为 false 以节省内存/GPU） -->
  <arg name="show_rviz" default="true"/>

  <!-- ==================== 基础飞控链路 ==================== -->
  <!-- 启动 MAVROS 与飞控通信链路。 -->
  <include file="$(find sub_planning)/launch/apm.launch"/>

  <!-- ==================== 边界加载节点 ==================== -->
  <!-- 这一组参数用于配置规划边界、仿真边界以及 RViz 边界标记的生成方式。 -->
  <node name="boundary_loader" pkg="sub_planning" type="boundary_loader.py" output="screen">
    <!-- 边界顶点来源：从 YAML 文件加载原始 GPS 边界点。 -->
    <rosparam command="load" file="$(find sub_planning)/config/boundary_points.yaml" />

    <!-- 仿真边界形状参数：控制仿真边界的外扩、平滑和起伏效果。 -->
    <param name="sim_boundary_margin" value="3.0"/>
    <param name="sim_boundary_smoothness" value="0.9"/>
    <param name="sim_boundary_resolution" value="160"/>
    <param name="sim_boundary_variation" value="30"/>
    <param name="sim_boundary_min_clearance_ratio" value="0.22"/>
    <param name="sim_boundary_max_clearance_ratio" value="0.58"/>

    <!-- 边界可视化参数：控制规划边界和仿真边界在 RViz 中的线宽与透明度。 -->
    <param name="plan_marker_width" value="0.18"/>
    <param name="plan_marker_alpha" value="0.35"/>
    <param name="sim_marker_width" value="0.42"/>
    <param name="sim_marker_alpha" value="0.95"/>
  </node>

  <!-- ==================== 预留节点 ==================== -->
  <!-- 这里保留了动态目标与旧版跟踪节点的启动位置，当前默认不启用。 -->
  <!-- <node name="dynamic_target_generator" pkg="sub_planning" type="dynamic_target_generator.py" output="screen"/>

  <node name="target_tracking_pos" pkg="sub_planning" type="target_tracking_pos.py" output="screen"/> -->

  <!-- ==================== 速度控制节点 ==================== -->
  <!-- 这一组参数用于配置速度控制桥接节点的输出频率。 -->
  <node name="set_body_vel_yaw_node" pkg="sub_planning" type="set_body_vel_yaw.py" output="screen">
    <param name="control_rate" value="$(arg vel_ctrl_rate)"/>
  </node>

  <!-- ==================== 位置控制节点 ==================== -->
  <!-- 这一组参数用于在位置控制模式下配置 PID 增益、输出限幅和控制周期。 -->
  <node name="set_local_position_node" pkg="sub_planning" type="set_local_position.py" output="screen" if="$(arg pos_ctrl)">
    <!-- X 轴位置控制参数：控制前向位置误差的 PID 响应。 -->
    <param name="kp_x" value="0.5"/>
    <param name="ki_x" value="0.01"/>
    <param name="kd_x" value="0.1"/>

    <!-- Y 轴位置控制参数：控制横向位置误差的 PID 响应。 -->
    <param name="kp_y" value="0.5"/>
    <param name="ki_y" value="0.01"/>
    <param name="kd_y" value="0.1"/>

    <!-- Z 轴位置控制参数：控制深度或高度误差的 PID 响应。 -->
    <param name="kp_z" value="1"/>
    <param name="ki_z" value="0.02"/>
    <param name="kd_z" value="0.1"/>

    <!-- 偏航控制参数：控制航向误差的 PID 响应。 -->
    <param name="kp_yaw" value="0.5"/>
    <param name="ki_yaw" value="0.01"/>
    <param name="kd_yaw" value="0.01"/>

    <!-- 输出限幅参数：限制线速度和偏航角速度的最大输出。 -->
    <param name="max_vel_x" value="0.5"/>
    <param name="max_vel_y" value="0.4"/>
    <param name="max_vel_z" value="0.3"/>
    <param name="max_yaw_rate" value="0.3"/>

    <!-- 控制周期参数：设置位置控制回路的运行时间步长。 -->
    <param name="pos_ctrl_dt" value="0.02"/>
  </node>

  <!-- ==================== 可视化 ==================== -->
  <!-- 启动 RViz、模型发布和 TF 广播链路（批量实验可关闭）。 -->
  <include if="$(arg show_rviz)" file="$(find sub_planning)/launch/rviz.launch"/>
</launch>
