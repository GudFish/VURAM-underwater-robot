<?xml version="1.0"?>
<launch>
  <!-- ====================================================================
   sonar_target_detector.launch
   可复用的前视声呐目标检测器启动文件。
   从前视声呐图像中提取候选目标、场景候选和调试图像。
   在所有跟踪方法中作为共享感知管道的一部分被引用。

   参数：
     enabled          – 是否启动检测节点（默认 true）
     debug_window     – 是否弹出调试图像窗口（默认 false）
  ==================================================================== -->

  <arg name="enabled" default="true"/>
  <arg name="debug_window" default="false"/>

  <!-- 声呐几何参数（实物实验传真实声呐参数，仿真保持默认） -->
  <arg name="fov_deg" default="130.0"/>
  <arg name="max_range" default="30.0"/>
  <arg name="min_range" default="0.2"/>

  <!-- ==================== 声呐目标检测节点 ==================== -->
  <node if="$(arg enabled)" name="forward_sonar_target_detector" pkg="sub_planning" type="forward_sonar_target_detector.py" output="screen">
    <!-- 话题接口参数：连接图像输入、方位引导和检测输出接口 -->
    <param name="image_topic" value="/forward_sonar/image"/>
    <param name="bearing_topic" value="/target_acoustic_bearing"/>
    <param name="measurement_topic" value="/forward_sonar/measurement"/>
    <param name="candidate_topic" value="/forward_sonar/candidates"/>
    <param name="scene_candidate_topic" value="/forward_sonar/scene_candidates"/>
    <param name="obstacle_topic" value="/forward_sonar/obstacles"/>
    <param name="debug_topic" value="/forward_sonar/detection_debug"/>
    <param name="debug_image_topic" value="/forward_sonar/debug_image"/>

    <!-- 声呐几何参数：定义检测使用的视场角和量程范围 -->
    <param name="fov_deg" value="$(arg fov_deg)"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="min_range" value="$(arg min_range)"/>

    <!-- 候选筛选参数：控制阈值、最小连通域和候选发布门槛 -->
    <param name="threshold_percentile" value="98.5"/>
    <param name="min_threshold" value="50.0"/>
    <param name="min_blob_area" value="16"/>
    <param name="publish_min_score" value="0.15"/>
    <param name="candidate_min_score" value="0.025"/>
    <param name="max_candidates" value="20"/>
    <param name="publish_scene_candidates" value="true"/>
    <param name="max_scene_candidates" value="16"/>
    <param name="max_obstacles" value="8"/>
    <param name="obstacle_min_score" value="0.04"/>
    <param name="obstacle_min_radius" value="0.20"/>
    <param name="obstacle_max_range" value="12.0"/>
    <param name="bearing_candidate_gate_deg" value="12.0"/>
    <param name="publish_candidates_without_bearing" value="true"/>
    <param name="publish_legacy_measurement" value="false"/>

    <!-- 对比度与局部阈值参数：增强弱小目标的局部检测能力 -->
    <param name="min_mean_contrast" value="7.0"/>
    <param name="min_peak_delta" value="6.0"/>
    <param name="min_excess_score" value="0.025"/>
    <param name="bearing_timeout" value="1.0"/>
    <param name="use_local_threshold" value="true"/>
    <param name="local_threshold_window_px" value="31"/>
    <param name="local_threshold_std_scale" value="0.9"/>
    <param name="local_threshold_min_delta" value="3.0"/>
    <param name="local_threshold_global_floor_ratio" value="0.25"/>

    <!-- 边界与近距离噪声抑制参数：过滤边界回波和近场噪声团 -->
    <param name="suppress_boundary_like_blobs" value="true"/>
    <param name="boundary_min_area" value="120"/>
    <param name="boundary_min_long_axis_px" value="45.0"/>
    <param name="boundary_min_physical_length_m" value="4"/>
    <param name="boundary_min_aspect_ratio" value="4.0"/>
    <param name="boundary_min_perimeter_area_ratio" value="1.2"/>
    <param name="boundary_mask_dilate_px" value="2"/>
    <param name="suppress_near_noise_blobs" value="true"/>
    <param name="near_noise_range_m" value="2.5"/>
    <param name="near_noise_min_area" value="32"/>
    <param name="near_noise_min_physical_length_m" value="0.45"/>

    <!-- 可选预处理与区域级检测参数（离线批量标注工具同款，默认关闭保持原行为） -->
    <param name="denoise_method" value="median"/>
    <param name="range_norm_enabled" value="true"/>
    <param name="use_region_detection" value="true"/>
    <!-- <param name="denoise_method" value="none"/>
    <param name="range_norm_enabled" value="false"/>
    <param name="use_region_detection" value="false"/> -->
    <param name="range_norm_smooth" value="15"/>
    <param name="region_threshold_percentile" value="93.0"/>
    <param name="region_min_threshold" value="40.0"/>
    <param name="region_min_blob_area" value="40"/>
    <param name="region_max_blob_area" value="600"/>
    <param name="region_max_range" value="25.0"/>
    <param name="region_near_gain" value="1.0"/>
  </node>

  <!-- ==================== 检测调试图像窗口 ==================== -->
  <node if="$(arg debug_window)" name="forward_sonar_detection_viewer" pkg="sub_planning" type="forward_sonar_image_viewer.py" output="screen">
    <param name="image_topic" value="/forward_sonar/debug_image"/>
    <param name="window_name" value="Forward Sonar Detection Debug"/>
    <param name="colormap" value="true"/>
    <param name="display_scale" value="1.4"/>
  </node>
</launch>
