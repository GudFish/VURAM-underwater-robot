<?xml version="1.0"?>
<launch>
  <!-- ==================== 随机种子参数 ==================== -->
  <!-- 非负整数种子用于场景复现；-1 表示不锁定随机序列。 -->
  <arg name="random_seed" default="-1"/>

  <!-- ==================== 机器人初始化相关参数 ==================== -->
  <!-- 这一组参数控制目标是否优先在机器人附近生成，以及等待里程计的行为。 -->
  <arg name="robot_odom_topic" default="/mavros/local_position/odom"/>
  <arg name="init_near_robot" default="True"/>
  <arg name="init_min_radius" default="6.0"/>
  <arg name="init_max_radius" default="12.0"/>
  <arg name="init_sample_attempts" default="80"/>
  <arg name="wait_robot_odom_timeout" default="10.0"/>

  <!-- ==================== 运动启动控制参数 ==================== -->
  <!-- 目标与障碍物在飞控解锁（ARM）后才开始运动，使运动时钟与记录时钟对齐。 -->
  <arg name="mavros_state_topic" default="/mavros/state"/>
  <arg name="motion_start_on_arm" default="true"/>
  <arg name="arm_wait_timeout" default="120.0"/>

  <!-- ==================== 目标运动速度范围参数 ==================== -->
  <!-- 目标巡航速度范围（m/s），各机动模式的目标速度在此范围内采样。 -->
  <arg name="target_speed_min" default="0.25"/>
  <arg name="target_speed_max" default="0.75"/>

  <!-- ==================== 目标发布与显示参数 ==================== -->
  <!-- 这一组参数定义动态目标位姿与目标网格可视化的输出接口。 -->
  <arg name="target_pose_topic" default="/dynamic_target/pose"/>
  <arg name="target_marker_topic" default="/dynamic_target/marker"/>
  <arg name="target_mesh_resource" default="package://vuram_description/meshes/AUV.STL"/>
  <arg name="target_mesh_scale" default="1.0"/>
  <arg name="target_mesh_z" default="0.0"/>

  <!-- ==================== 障碍物场景参数 ==================== -->
  <!-- 这一组参数控制动态障碍物的数量、尺寸和运动范围。 -->
  <arg name="obstacle_marker_topic" default="/dynamic_obstacles/markers"/>
  <arg name="obstacle_count" default="16"/>
  <arg name="obstacle_size_min" default="0.5"/>
  <arg name="obstacle_size_max" default="0.8"/>
  <arg name="obstacle_speed_min" default="0.1"/>
  <arg name="obstacle_speed_max" default="0.2"/>

  <!-- ==================== 动态目标生成节点 ==================== -->
  <!-- 这一组参数用于生成目标轨迹、目标网格和动态障碍物。 -->
  <node name="dynamic_target_generator" pkg="sub_planning" type="dynamic_target_generator.py" output="screen">
    <!-- 随机种子参数：控制目标轨迹、障碍物布局的随机性。 -->
    <param name="random_seed" value="$(arg random_seed)"/>

    <!-- 机器人与目标接口参数：连接里程计与目标位姿输出。 -->
    <param name="robot_odom_topic" value="$(arg robot_odom_topic)"/>
    <param name="target_pose_topic" value="$(arg target_pose_topic)"/>
    <param name="target_marker_topic" value="$(arg target_marker_topic)"/>

    <!-- 目标模型参数：配置目标网格资源、缩放和显示高度。 -->
    <param name="target_mesh_resource" value="$(arg target_mesh_resource)"/>
    <param name="target_mesh_scale" value="$(arg target_mesh_scale)"/>
    <param name="target_mesh_z" value="$(arg target_mesh_z)"/>

    <!-- 障碍物场景参数：配置障碍物标记输出、尺寸与速度范围。 -->
    <param name="obstacle_marker_topic" value="$(arg obstacle_marker_topic)"/>
    <param name="obstacle_count" value="$(arg obstacle_count)"/>
    <param name="obstacle_size_min" value="$(arg obstacle_size_min)"/>
    <param name="obstacle_size_max" value="$(arg obstacle_size_max)"/>
    <param name="obstacle_speed_min" value="$(arg obstacle_speed_min)"/>
    <param name="obstacle_speed_max" value="$(arg obstacle_speed_max)"/>

    <!-- 初始采样参数：控制目标初始位置与机器人之间的关系。 -->
    <param name="init_near_robot" value="$(arg init_near_robot)"/>
    <param name="init_min_radius" value="$(arg init_min_radius)"/>
    <param name="init_max_radius" value="$(arg init_max_radius)"/>
    <param name="init_sample_attempts" value="$(arg init_sample_attempts)"/>
    <param name="wait_robot_odom_timeout" value="$(arg wait_robot_odom_timeout)"/>

    <!-- 运动启动控制：等待 ARM 后才开始目标/障碍物运动。 -->
    <param name="mavros_state_topic" value="$(arg mavros_state_topic)"/>
    <param name="motion_start_on_arm" value="$(arg motion_start_on_arm)"/>
    <param name="arm_wait_timeout" value="$(arg arm_wait_timeout)"/>

    <!-- 目标运动速度范围（m/s）。 -->
    <param name="target_speed_min" value="$(arg target_speed_min)"/>
    <param name="target_speed_max" value="$(arg target_speed_max)"/>
  </node>
</launch>
