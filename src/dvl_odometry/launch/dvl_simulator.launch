<?xml version="1.0"?>
<launch>
  <!-- Shared deterministic trajectory; IMU includes gravity. Angles/rates use radians. -->
  <arg name="ip" default="127.0.0.1"/>
  <arg name="port" default="16171"/>
  <arg name="velocity_rate" default="10.0"/>
  <arg name="dr_rate" default="5.0"/>
  <arg name="publish_imu" default="false"/>
  <arg name="imu_rate" default="100.0"/>
  <arg name="imu_stamp_offset" default="0.0"/>
  <arg name="speed" default="0.3"/>
  <arg name="acceleration" default="0.0"/>
  <arg name="yaw_rate" default="0.1"/>
  <arg name="roll" default="0.0"/>
  <arg name="pitch" default="0.0"/>
  <node name="dvl_simulator" pkg="dvl_odometry" type="mavros_imu_simulator.py" output="screen" required="true">
    <param name="ip" value="$(arg ip)"/>
    <param name="port" value="$(arg port)"/>
    <param name="velocity_rate" value="$(arg velocity_rate)"/>
    <param name="dr_rate" value="$(arg dr_rate)"/>
    <param name="publish_imu" value="$(arg publish_imu)"/>
    <param name="imu_rate" value="$(arg imu_rate)"/>
    <param name="imu_stamp_offset" value="$(arg imu_stamp_offset)"/>
    <param name="speed" value="$(arg speed)"/>
    <param name="acceleration" value="$(arg acceleration)"/>
    <param name="yaw_rate" value="$(arg yaw_rate)"/>
    <param name="roll" value="$(arg roll)"/>
    <param name="pitch" value="$(arg pitch)"/>
  </node>
</launch>
