<?xml version="1.0"?>
<launch>
  <!-- One transport, exactly one odometry mode. Unknown mode raises an eval error. -->
  <arg name="mode" default="dvl_fused"/>
  <arg name="selected_mode" value="$(eval {'dvl_raw': 'dvl_raw', 'dvl_fused': 'dvl_fused', 'mavros_fused': 'mavros_fused'}[arg('mode')])"/>
  <arg name="ip" default="192.168.1.95"/>
  <arg name="port" default="16171"/>
  <arg name="reconnect_min_delay" default="1.0"/>
  <arg name="reconnect_max_delay" default="30.0"/>
  <arg name="reset_on_start" default="true"/>
  <arg name="apply_config" default="false"/>
  <arg name="speed_of_sound" default="0.0"/>
  <arg name="mounting_rotation_offset" default="0.0"/>
  <arg name="velocity_rate" default="0.0"/>
  <arg name="odom_rate" default="20.0"/>
  <arg name="publish_tf" default="false"/>
  <arg name="publish_z" default="true"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="robot_frame" default="base_link"/>
  <arg name="dvl_frame" default="dvl_link"/>
  <arg name="odom_topic" default="/dvl/odom"/>
  <arg name="vel_timeout" default="1.0"/>
  <arg name="dr_timeout" default="1.0"/>
  <arg name="angular_timeout" default="$(arg dr_timeout)"/>
  <arg name="angular_filter_tau" default="0.2"/>
  <arg name="angular_max_rate" default="3.0"/>
  <arg name="imu_timeout" default="0.5"/>
  <arg name="imu_future_tolerance" default="0.02"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>

  <node name="dvl_velocity_node" pkg="dvl_odometry" type="dvl_velocity_node.py" output="screen" required="true">
    <param name="ip" value="$(arg ip)"/>
    <param name="port" value="$(arg port)"/>
    <param name="reconnect_min_delay" value="$(arg reconnect_min_delay)"/>
    <param name="reconnect_max_delay" value="$(arg reconnect_max_delay)"/>
    <param name="reset_on_start" value="$(arg reset_on_start)"/>
    <param name="apply_config" value="$(arg apply_config)"/>
    <param name="speed_of_sound" value="$(arg speed_of_sound)"/>
    <param name="mounting_rotation_offset" value="$(arg mounting_rotation_offset)"/>
    <param name="velocity_rate" value="$(arg velocity_rate)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="robot_frame" value="$(arg robot_frame)"/>
    <param name="dvl_frame" value="$(arg dvl_frame)"/>
    <param name="vel_timeout" value="$(arg vel_timeout)"/>
    <param name="dr_timeout" value="$(arg dr_timeout)"/>
  </node>

  <group unless="$(eval arg('selected_mode') == 'mavros_fused')">
    <node name="dvl_odometry_node" pkg="dvl_odometry"
          type="$(eval 'dvl_odometry_node.py' if arg('selected_mode') == 'dvl_raw' else 'dvl_fusion_node.py')"
          output="screen" required="true">
      <param name="odom_rate" value="$(arg odom_rate)"/>
      <param name="publish_tf" value="$(arg publish_tf)"/>
      <param name="publish_z" value="$(arg publish_z)"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="robot_frame" value="$(arg robot_frame)"/>
      <param name="odom_topic" value="$(arg odom_topic)"/>
      <param name="vel_timeout" value="$(arg vel_timeout)"/>
      <param name="dr_timeout" value="$(arg dr_timeout)"/>
      <param name="angular_timeout" value="$(arg angular_timeout)"/>
      <param name="angular_filter_tau" value="$(arg angular_filter_tau)"/>
      <param name="angular_max_rate" value="$(arg angular_max_rate)"/>
    </node>
  </group>

  <group if="$(eval arg('selected_mode') == 'mavros_fused')">
    <node name="dvl_ekf" pkg="robot_localization" type="ekf_localization_node" output="screen" required="true">
      <rosparam command="load" file="$(find dvl_odometry)/config/mavros_ekf.yaml"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="world_frame" value="$(arg odom_frame)"/>
      <param name="base_link_frame" value="$(arg robot_frame)"/>
      <remap from="odometry/filtered" to="/dvl/ekf/odom"/>
      <remap from="set_pose" to="/dvl/ekf/set_pose"/>
    </node>
    <node name="mavros_dvl_fusion_node" pkg="dvl_odometry" type="mavros_dvl_fusion_node.py" output="screen" required="true">
      <param name="imu_topic" value="$(arg imu_topic)"/>
      <param name="imu_timeout" value="$(arg imu_timeout)"/>
      <param name="imu_future_tolerance" value="$(arg imu_future_tolerance)"/>
      <param name="vel_timeout" value="$(arg vel_timeout)"/>
      <param name="publish_tf" value="$(arg publish_tf)"/>
      <param name="publish_z" value="$(arg publish_z)"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="robot_frame" value="$(arg robot_frame)"/>
      <param name="odom_topic" value="$(arg odom_topic)"/>
    </node>
  </group>
</launch>
