<?xml version="1.0"?>
<launch>
  <!-- Continuous real-robot collection: one horizontal figure8 per H5.
       latest.json is prepared in the background; model swaps occur only at
       lap boundaries. The fixed reference is anchored once AFTER arming.
       setup_fc configures VECTORED (FRAME_CONFIG=1), never CUSTOM bypass.
       Control remains gated by bridge ready/enabled + connected/armed/MANUAL.
       Run run_train.py in phase=online separately against the same data root. -->
  <arg name="fcu_url" default="udp://127.0.0.1:14551@14555"/>
  <arg name="setup_fc" default="false"/>
  <arg name="arm_vehicle" default="false"/>

  <!-- Empty model_dir follows model_root/latest.json. A nonempty directory
       pins one immutable deploy.pt + spec.json and disables hot updates. -->
  <arg name="learning_root" default="$(env HOME)/mujoco_auv_env"/>
  <arg name="model_root" default="$(arg learning_root)/data/vnd/models"/>
  <arg name="data_dir" default="$(arg learning_root)/data/vnd/inbox"/>
  <arg name="model_dir" default=""/>
  <arg name="spec" default="$(find vuram_control)/config/obs_act.yaml"/>
  <arg name="device" default="cpu"/>
  <!-- Small batch-one actors use one CPU thread to leave CPU time for SITL,
       MAVROS and the watchdog. Model preparation uses the same thread budget. -->
  <arg name="inference_threads" default="1"/>

  <!-- T rounds to whole control intervals. V is the PEAK horizontal speed.
       Ax=V*T/(2*pi*sqrt(1+4*ratio^2)); Ay=ratio*Ax. No end-of-lap braking.
       World depth and initial tangent come from the actual starting pose. -->
  <arg name="episode_len_s" default="20.0"/>
  <arg name="ref_speed" default="1.0"/>
  <arg name="figure8_ratio" default="0.4"/>

  <arg name="dof_cmd_topic" default="/dof_cmd"/>
  <arg name="ready_topic" default="$(arg dof_cmd_topic)/ready"/>
  <arg name="enabled_topic" default="$(arg dof_cmd_topic)/enabled"/>
  <arg name="state_topic" default="/mavros/state"/>
  <arg name="wait_ready" default="true"/>
  <arg name="wait_param_list" default="true"/>
  <!-- MAVROS may need multiple per-call waits to finish its initial download. -->
  <arg name="param_wait_timeout" default="180.0"/>
  <arg name="param_pull_service" default="/mavros/param/pull"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <!-- Configure FC telemetry after parameter synchronization, then verify the
       actual callback rates before starting. Other odometry sources manage
       their own rates and skip MAVROS rate/IMU setup by default. -->
  <arg name="configure_mavros_rates" default="$(eval arg('odom_topic').endswith('/local_position/odom'))"/>
  <arg name="message_interval_service" default="/mavros/set_message_interval"/>
  <arg name="mavros_telemetry_rate" default="30.0"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="odom_ready_window" default="1.0"/>
  <arg name="odom_timeout" default="0.2"/>
  <!-- MAVROS/DVL twist is body FLU by default; world-frame sources use true. -->
  <arg name="twist_in_world" default="false"/>
  <arg name="viz_frame_id" default="map"/>
  <arg name="enable_viz" default="true"/>
  <arg name="enable_rviz" default="true"/>

  <include file="$(find vuram_control)/launch/apm.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
  </include>

  <node name="set_6dof_cmd" pkg="vuram_control" type="set_6dof_cmd.py" output="screen">
    <param name="setup_fc_params" type="bool" value="$(arg setup_fc)"/>
    <param name="frame_config" type="int" value="1"/>
    <param name="acro_yaw_p" type="double" value="4.5"/>
    <param name="arm_vehicle" type="bool" value="$(arg arm_vehicle)"/>
    <param name="mode" value="MANUAL"/>
    <param name="cmd_topic" value="$(arg dof_cmd_topic)"/>
    <param name="cmd_out_topic" value="$(arg dof_cmd_topic)/out"/>
    <param name="state_topic" value="$(arg state_topic)"/>
    <param name="ready_topic" value="$(arg ready_topic)"/>
    <param name="enabled_topic" value="$(arg enabled_topic)"/>
  </node>

  <node name="policy_inference" pkg="vuram_control" type="policy_inference_node.py"
        output="screen" required="true"
        args="--spec &quot;$(arg spec)&quot; --episode_len_s $(arg episode_len_s)">
    <param name="ref_source" value="collect"/>
    <param name="learning_root" value="$(arg learning_root)"/>
    <param name="model_root" value="$(arg model_root)"/>
    <param name="data_dir" value="$(arg data_dir)"/>
    <param name="model_dir" type="str" value="$(arg model_dir)"/>
    <param name="device" value="$(arg device)"/>
    <param name="inference_threads" value="$(arg inference_threads)"/>
    <param name="ref_speed" value="$(arg ref_speed)"/>
    <param name="figure8_ratio" value="$(arg figure8_ratio)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="configure_mavros_rates" value="$(arg configure_mavros_rates)"/>
    <param name="message_interval_service" value="$(arg message_interval_service)"/>
    <param name="mavros_telemetry_rate" value="$(arg mavros_telemetry_rate)"/>
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="odom_ready_window" value="$(arg odom_ready_window)"/>
    <param name="odom_timeout" value="$(arg odom_timeout)"/>
    <param name="twist_in_world" value="$(arg twist_in_world)"/>
    <param name="cmd_topic" value="$(arg dof_cmd_topic)"/>
    <param name="state_topic" value="$(arg state_topic)"/>
    <param name="ready_topic" value="$(arg ready_topic)"/>
    <param name="enabled_topic" value="$(arg enabled_topic)"/>
    <param name="wait_ready" value="$(arg wait_ready)"/>
    <param name="wait_param_list" value="$(arg wait_param_list)"/>
    <param name="param_wait_timeout" value="$(arg param_wait_timeout)"/>
    <param name="param_pull_service" value="$(arg param_pull_service)"/>
    <param name="viz" value="$(arg enable_viz)"/>
    <param name="viz_frame_id" value="$(arg viz_frame_id)"/>
  </node>

  <include if="$(arg enable_rviz)" file="$(find vuram_control)/launch/rviz.launch">
    <arg name="display_config" value="$(find vuram_control)/config/policy_eval_ardusub.rviz"/>
  </include>
</launch>
